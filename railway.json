{
  "build": {
    "commands": {
      "laravel": "cd laravel && composer install && php artisan migrate && php artisan config:cache",
      "node": "cd node && npm install"
    }
  },
  "start": {
    "commands": {
      "laravel": "cd laravel && php artisan serve --host=0.0.0.0 --port=$PORT",
      "node": "cd node && node index.js"
    }
  }
}
